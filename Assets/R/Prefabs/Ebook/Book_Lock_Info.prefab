  m_Text: "\u4E2D\u83EF\u767D\u6D77\u8C5A\uFF08\u5B78\u540D\uFF1ASousa chinensis\uFF09\n-
    \u5C6C\u9BE8\u76EE\u6D77\u8C5A\u79D1\n- \u9999\u6E2F\u7684\u5409\u7965\u7269\u4E4B\u4E00\n-
    \u8EAB\u9577\uFF1A\u4E00\u7C73\u5230\u4E09\u7C73\u4E0D\u7B49\n\u73FE\u6642\u9999\u6E2F\u548C\u73E0\u6C5F\u53E3\u4E00\u5E36\u7D04\u670947\u689D\u4E2D\u83EF\u767D\u6D77\u8C5A\u3002\n\u7260\u5011\u53D7\u6CD5\u4F8B\u7B2C
